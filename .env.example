# Copy to .env and adjust. .env is git-ignored.
# Directory containing Qwen3.5-9B-Q4_K_M.gguf (mounted into the llama.cpp container)
LLM_GGUF_DIR=/path/to/Qwen3.5-9B-GGUF
# Optional: OpenJev model directory (default: models/APUS-OpenJev-v1/9B-3000)
# JEV_MODEL_DIR=models/APUS-OpenJev-v1/9B-3000
# Optional: GPU index for the OpenJev service (default: 1)
# JEV_GPU=1
